<Window x:Class="VigenereCipher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VigenereCipher"
        mc:Ignorable="d"
        Title="O Pylypenko Vigenere cipher" Height="450" Width="400">
    <Grid >
        <StackPanel Margin = "10" >
            <TextBlock Text = "Enter Word:" />
            <TextBox x:Name = "WordTextBox" />
            <TextBlock Text = "Enter Key:" />
            <TextBox x:Name = "KeyTextBox" />
            <StackPanel Orientation = "Horizontal" Margin = "0,10,0,0" >
                <Button Content = "Encrypt" Click = "Encrypt_Click" Width = "100" Margin="100 0 0 0" />
                <Button Content = "Decrypt" Click = "Decrypt_Click" Width = "100" Margin = "10 0 0 0" />
            </StackPanel>
            <TextBlock Text = "Result:" />
            <TextBox x:Name = "ResultTextBox" IsReadOnly = "True" />
        </StackPanel>
    </Grid>
</Window>
